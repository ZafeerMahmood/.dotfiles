# Appended to ~/.ssh/config by install.sh. Host aliases match the Windows setup.
Host *
  AddKeysToAgent yes
  UseKeychain yes

# Personal Github
Host pers
  Hostname github.com
  User git
  IdentityFile ~/.ssh/personal
  IdentitiesOnly yes

# Work Github
Host work
  Hostname github.com
  User git
  IdentityFile ~/.ssh/work
  IdentitiesOnly yes
